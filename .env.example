# Copy to .env and fill values locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-long-random-secret
MANUS_OAUTH_API_URL=https://your-manus-oauth-api
OWNER_OPEN_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MANUS_API_URL=
MANUS_API_KEY=

# Optional remote MCP mesh. Each server exposes tools; GUIDATHON invokes only
# tools explicitly annotated readOnlyHint=true. Store tokens in separate env vars.
# Example: [{"name":"docs","url":"https://your-mcp-host/mcp","tokenEnv":"DOCS_MCP_TOKEN"}]
MCP_SERVERS_JSON=
DOCS_MCP_TOKEN=

# Legacy single-server configuration remains supported.
MCP_SERVER_URL=
MCP_SERVER_TOKEN=

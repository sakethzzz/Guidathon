# Copy to .env and fill values locally. Never commit real credentials.
NODE_ENV=development
PORT=3000

# MySQL persistence (required for persistent workspaces and RAG)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Manus OAuth/session (required for sign-in and protected persistence routes)
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-long-random-secret
MANUS_OAUTH_API_URL=https://your-manus-oauth-api
OWNER_OPEN_ID=

# Free-tier model providers (at least one provider is needed for generated agent responses)
# Create an eligible free API key in Google AI Studio or Groq; store it only in Vercel/local server env.
# GUIDATHON uses Gemini first, then Groq. Paid managed fallback is disabled by default.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Paid/managed fallback is disabled by default. Set true only if explicitly desired.
ALLOW_PAID_MODEL_FALLBACK=false
# Optional managed-model fallback (ignored unless ALLOW_PAID_MODEL_FALLBACK=true)
MANUS_API_URL=
MANUS_API_KEY=

# Public read-only Wikipedia MCP is the default; set this only to override it.
# Default: https://wikipedia.caseyjhand.com/mcp
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
